{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noorix-digital-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/files/*", "/sitemap.xml", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noorix-db",
      // Replace with the id printed by: npx wrangler d1 create noorix-db
      "database_id": "ffc0f3e4-8e42-443f-a21c-1fc93a55eae7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "noorix-files" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "SITE_URL": "https://noorixdigitallab.online",
    "SITE_NAME": "NOORIX DIGITAL LAB",
    "WHATSAPP": "923154429417"
  },
  "observability": { "enabled": true },
  // SECRETS (never put these here). Set with: npx wrangler secret put <NAME>
  //   ENCRYPTION_KEY  - base64 of 32 random bytes (inventory/delivery encryption)
  //   SETUP_TOKEN     - one-time token to create the first Super Admin
  //   EMAIL_API_KEY   - optional (Resend) for transactional email
  //   PAYFAST_MERCHANT_ID / PAYFAST_SECURED_KEY - optional, PayFast gateway
  //   PROVIDER_<CODE>_KEY - optional, one per API provider
  "keep_vars": true
}
