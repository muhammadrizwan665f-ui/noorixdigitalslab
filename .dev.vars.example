# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars)
ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-base64_32
SETUP_TOKEN=choose-a-long-random-string
# Google sign-in (optional) - see docs/GOOGLE_LOGIN.md
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
