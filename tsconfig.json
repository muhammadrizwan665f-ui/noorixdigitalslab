{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "types": ["@cloudflare/workers-types"], "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["worker", "src", "tests", "vite.config.ts"]
}
